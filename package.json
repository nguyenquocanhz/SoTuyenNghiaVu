    "react-native",
    "expo",
    "vietnam",
    "nghia-vu-quan-su",
    "so-tuyen-suc-khoe",
    "thong-tu-105-2023-tt-bqp",
    "thong-tu-106-2025-tt-bqp",
    "tram-y-te",
    "health-screening",
    "nfc",
    "cccd",
    "bluetooth-le",
    "offline",
    "pdf"
  ],
  "license": "Apache-2.0",
  "author": "nguyenquocanhz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenquocanhz/SoTuyenNghiaVu.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenquocanhz/SoTuyenNghiaVu/issues"
  },
  "homepage": "https://github.com/nguyenquocanhz/SoTuyenNghiaVu#readme",
  "main": "expo-router/entry",
  "scripts": {
